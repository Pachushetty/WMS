# Copy this file to ".env" (in the same folder, WMS/) and fill in your key.
# Get a free key at https://console.groq.com/keys
#
# Used for identifying the specific waste item name (e.g. "plastic water
# bottle", "AA battery") in app/app.py. If this is not set, the app still
# works — it just falls back to a CLIP-based guess from a fixed label list
# instead of Groq's free-form identification.
GROQ_API_KEY=your_groq_api_key_here

# A stable, random signing key for session cookies. Required for production;
# if unset, the app will generate a temporary one at startup and log a
# warning (sessions won't persist across restarts).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: set your own initial admin credentials instead of an
# auto-generated one-time password on first run.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@ecocycle.ai
# ADMIN_PASSWORD=

# Set to "production" to mark session cookies as HTTPS-only (Secure).
# FLASK_ENV=production

# --- Required in production (e.g. on Vercel) ---------------------------

# PostgreSQL connection string. app/database.py requires this to be set.
# Locally, run a Postgres instance and point this at it, or use a free
# hosted one (Neon, Supabase, Vercel Postgres via the Neon integration).
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Vercel Blob read/write token, used to persist uploaded photos (Vercel's
# filesystem is temporary). Create a Blob store in the Vercel dashboard
# (Storage tab) and it'll add this automatically to your project's env vars.
# If unset, uploaded images are saved to app/static/uploads/ instead, which
# works locally but NOT on Vercel (read-only filesystem there).
BLOB_READ_WRITE_TOKEN=

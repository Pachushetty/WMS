# Copy this file to ".env" (in the same folder, WMS/) and fill in your keys.

# PRIMARY vision provider. Get a free key at https://console.groq.com/keys
# Used to identify the specific waste item (e.g. "plastic water bottle",
# "AA battery") in app/app.py.
GROQ_API_KEY=your_groq_api_key_here

# FALLBACK vision provider, used automatically only if Groq is unreachable
# or errors out. Get a free key at https://aistudio.google.com/app/apikey
# If left unset, the app still works — it just skips straight from a
# failed Groq attempt to a second Groq retry instead of trying Gemini
# in between.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override which Gemini model the fallback uses. Defaults to
# "gemini-flash-latest" (a Google-maintained alias for their current fast
# model), which avoids needing to hand-update this when a specific dated
# model gets deprecated.
# GEMINI_VISION_MODEL=gemini-flash-latest

# A stable, random signing key for session cookies. Required for production;
# if unset, the app will generate a temporary one at startup and log a
# warning (sessions won't persist across restarts).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Required: PostgreSQL connection string.
DATABASE_URL=

# Optional: set your own initial admin credentials instead of an
# auto-generated one-time password on first run.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@ecocycle.ai
# ADMIN_PASSWORD=

# Set to "production" to mark session cookies as HTTPS-only (Secure).
# FLASK_ENV=production
